{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "vite-plugin-pwa/client"],
    // Shared code lives in packages/ (see README): one import name per package.
    "paths": {
      "@shared/*": ["./packages/shared/src/*"],
      "@grimoire-core/*": ["./packages/grimoire-core/src/*"],
      "@workshop-core/*": ["./packages/workshop-core/src/*"]
    }
  },
  "include": ["src", "packages", "vite.config.ts"]
}
